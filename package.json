{
  "name": "multiplayer-card-board-games",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready online multiplayer card & board game platform (UNO, Exploding Kittens, Tien Len Mien Nam)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "start": "npm --prefix server start",
    "test:server": "npm --prefix server test"
  },
  "keywords": ["multiplayer", "uno", "exploding-kittens", "tien-len", "game-engine", "socket-io", "react"],
  "author": "",
  "license": "MIT"
}
